# Copy to .env and fill in, then: set -a; source .env; set +a; go run ./cmd/financesite
# Without the two Plaid values the server runs in demo mode on sample data.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks, free) or production (real accounts)
PLAID_ENV=sandbox

# Optional
# FINANCESITE_ADDR=localhost:8080
# FINANCESITE_DATA_DIR=./data/local
# FINANCESITE_UI_DIR=./ui/dist
